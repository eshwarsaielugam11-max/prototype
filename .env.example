# ==============================================================================
# Parkinson's Disease Voice Screening Platform - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Hosted LLM Report Generation (Free-Tier API)
# ------------------------------------------------------------------------------
# NOTICE: This is the ONE external network dependency in the entire platform.
# No credit card is required. You can obtain a 100% free API key from:
#   - Primary (Groq):    https://console.groq.com/keys (30 req/min, 1,000 req/day)
#   - Fallback (Gemini): https://aistudio.google.com/app/apikey (15 req/min, 1,500 req/day)
#   - Alternative:       https://openrouter.ai/keys
#
# Choose your active provider: "groq" | "gemini" | "openrouter" | "ollama"
LLM_PROVIDER=groq

# Your free API key from the chosen provider (REQUIRED for report generation)
LLM_API_KEY=your-groq-api-key-here

# Target model on the provider:
#   Groq:       "llama-3.3-70b-versatile" or "llama-3.1-8b-instant"
#   Gemini:     "gemini-2.5-flash" or "gemini-1.5-flash"
#   OpenRouter: "meta-llama/llama-3.3-70b-instruct"
LLM_MODEL=llama-3.3-70b-versatile

# Base URL for OpenAI-compatible providers:
#   Groq:       "https://api.groq.com/openai/v1"
#   OpenRouter: "https://openrouter.ai/api/v1"
LLM_BASE_URL=https://api.groq.com/openai/v1

# ------------------------------------------------------------------------------
# Optional Local LLM Fallback (Ollama)
# ------------------------------------------------------------------------------
# If LLM_PROVIDER=ollama, the platform connects to your local Ollama daemon.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# ------------------------------------------------------------------------------
# Vector DB & Embeddings (BAAI/bge-small-en-v1.5 + ChromaDB)
# ------------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./rag/knowledge_base/chroma_db

# ------------------------------------------------------------------------------
# Relational Database (SQLite Local History)
# ------------------------------------------------------------------------------
SQLITE_DB_PATH=./backend/app.db

# ------------------------------------------------------------------------------
# Machine Learning Model Artifacts
# ------------------------------------------------------------------------------
MODEL_ARTIFACT_DIR=./models/artifact

# ------------------------------------------------------------------------------
# Audio Upload Settings
# ------------------------------------------------------------------------------
MAX_UPLOAD_MB=25
ALLOWED_AUDIO_FORMATS=wav,mp3,flac,m4a,ogg

# ------------------------------------------------------------------------------
# Server & Network Ports
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO
